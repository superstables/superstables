{
  "name": "@superstables/client",
  "version": "0.5.0",
  "description": "Superstables client: discover paid services, quote them, and pay from an owner-controlled wallet. CLI and agent skill.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/superstables/superstables.git" },
  "homepage": "https://www.superstables.com",
  "bugs": { "url": "https://github.com/superstables/superstables/issues" },
  "keywords": ["x402", "mpp", "ai-agents", "payments", "usdc", "testnet"],
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "superstables": "./dist/cli/main.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./seller": { "types": "./dist/seller/index.d.ts", "import": "./dist/seller/index.js" }
  },
  "publishConfig": { "access": "public" },
  "files": ["dist", "policy.example.yaml", "npm-shrinkwrap.json", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/budget-build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "node scripts/prepare.mjs --pack",
    "postpack": "node scripts/shrinkwrap.mjs remove",
    "prepublishOnly": "node scripts/publish-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:fast": "SUPERSTABLES_TEST_TIER=fast node scripts/test.mjs",
    "test:live": "SUPERSTABLES_LIVE=1 node scripts/test.mjs test/live",
    "dev": "tsx src/cli/main.ts",
    "skill": "node scripts/skill.mjs",
    "skill:check": "node scripts/plugin-sync.mjs --check && node scripts/skill-check.mjs",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:check": "node scripts/plugin-sync.mjs --check",
    "install-check": "node scripts/install-check.mjs",
    "docs:cli": "node scripts/cli-docs.mjs",
    "audit:shipped": "node scripts/bundle-audit.mjs",
    "repro-check": "node scripts/repro-check.mjs"
  },
  "dependencies": {
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "commander": "14.0.3",
    "viem": "2.56.6",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "overrides": {
    "jayson": "5.0.0",
    "@x402/core": {
      "zod": "$zod"
    },
    "@x402/evm": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@solana/web3.js": "1.99.0",
    "@types/node": "^20.19.0",
    "@x402/fetch": "2.26.0",
    "bs58": "6.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "mppx": "0.11.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
